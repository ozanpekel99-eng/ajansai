# ---- Genel ----
# Railway'de "production" yap. Production'da JWT_SECRET zorunlu, /docs kapalı.
ENVIRONMENT=development
# Uzun ve rastgele olmalı:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Web uygulamasının adresi (ödeme sonrası buraya yönlendirilir)
WEB_URL=http://localhost:3000
# Bu backend'in dışarıdan erişilen adresi (iyzico callback için)
PUBLIC_API_URL=http://localhost:8000
# API'yi çağırabilecek web adresleri, virgülle ayrılmış
ALLOWED_ORIGINS=http://localhost:3000

# ---- Veritabanı ----
# Boş bırakılırsa yerel SQLite (data.db). Railway'de Postgres ekleyince
# DATABASE_URL=${{Postgres.DATABASE_URL}} olarak bağla.
DATABASE_URL=

# ---- Yapay zeka (metin) ----
# OmniRoute adresi /v1 ile biter. Tanımlıysa tüm metin üretimi OmniRoute'tan geçer.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# OmniRoute'taki model adı (sağlayıcı/model) veya bir combo adı
OMNIROUTE_MODEL=anthropic/claude-sonnet-5
# OmniRoute yoksa ya da hata verirse doğrudan Claude kullanılır (önerilir: yedek olarak doldur)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Görsel / video ----
IDEOGRAM_API_KEY=
RUNWAY_API_KEY=

# ---- Meta ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/ads/callback

# ---- iyzico ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
