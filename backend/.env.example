# ---- Genel ----
# Railway'de "production" yap. Production'da JWT_SECRET zorunlu, /docs kapalı.
ENVIRONMENT=development
# Uzun ve rastgele olmalı:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Web uygulamasının adresi (ödeme sonrası buraya yönlendirilir)
WEB_URL=http://localhost:3000
# Bu backend'in dışarıdan erişilen adresi (iyzico callback için)
PUBLIC_API_URL=http://localhost:8000
# API'yi çağırabilecek web adresleri, virgülle ayrılmış
ALLOWED_ORIGINS=http://localhost:3000

# ---- Veritabanı ----
# Boş bırakılırsa yerel SQLite (data.db). Railway'de Postgres ekleyince
# DATABASE_URL=${{Postgres.DATABASE_URL}} olarak bağla.
DATABASE_URL=

# ---- Yapay zeka (metin) ----
# OmniRoute adresi /v1 ile biter. Tanımlıysa tüm metin üretimi OmniRoute'tan geçer.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# OmniRoute'taki model adı (sağlayıcı/model) veya bir combo adı
OMNIROUTE_MODEL=anthropic/claude-sonnet-5
# OmniRoute yoksa ya da hata verirse doğrudan Claude kullanılır (önerilir: yedek olarak doldur)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Görsel / video ----
# Görsel ve video Vercel AI Gateway üzerinden üretilir (ayrı anahtar gerekmez)
IMAGE_MODEL=bytedance/seedream-5.0-pro
VIDEO_MODEL=bytedance/seedance-v1.5-pro
# Üretilen dosyalar için Vercel Blob (projeye Blob deposu bağlanınca otomatik gelir)
BLOB_READ_WRITE_TOKEN=

# ---- Meta ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/ads/callback

# ---- iyzico ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ---- Mobil uygulama içi satın alma (RevenueCat) ----
# RevenueCat → Integrations → Webhooks → Authorization header değeri. Boşsa webhook kapalı.
REVENUECAT_WEBHOOK_AUTH=
# İsteğe bağlı: ürün kimliği eşleşmesi (JSON), ör. {"ajansai_pro_aylik": "pro:monthly"}
REVENUECAT_PRODUCTS=

# ---- Ücretsiz paket ----
# Fikir sohbeti: Groq / Cerebras ücretsiz katmanları, kotalar dolarsa Haiku 5.5
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Ücretsiz AI görseli: Cloudflare Workers AI (günlük 10.000 neuron ücretsiz)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Stok fotoğraf: Pixabay (öncelikli) veya Pexels
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Sohbette web araması: GROQ_API_KEY yeterli (Groq yerleşik arama); Tavily isteğe bağlı
TAVILY_API_KEY=
# Doğal sesli okuma (Google Cloud Text-to-Speech)
GOOGLE_TTS_API_KEY=
