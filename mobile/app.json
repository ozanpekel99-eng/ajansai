{
  "expo": {
    "name": "ajansAI",
    "slug": "ajansai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ajansai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "tr.ajansai.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ürün fotoğraflarını görsel ve video üretiminde kullanmak için fotoğraflarına erişiyoruz.",
        "NSPhotoLibraryAddUsageDescription": "Ürettiğin görsel ve videoları galerine kaydetmek için.",
        "NSCameraUsageDescription": "Ürün fotoğrafı çekip görsel ve video üretiminde kullanmak için.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "tr.ajansai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ürün fotoğraflarını görsel ve video üretiminde kullanmak için fotoğraflarına erişiyoruz.",
          "cameraPermission": "Ürün fotoğrafı çekip görsel ve video üretiminde kullanmak için."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ürettiğin görsel ve videoları galerine kaydetmek için.",
          "savePhotosPermission": "Ürettiğin görsel ve videoları galerine kaydetmek için."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.ajansai.tr",
      "eas": {
        "projectId": "2b271612-46f6-4106-bbfc-98759a7118e1"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ajansai.tr"
  }
}